---
import { getCollection, render } from "astro:content";
import { existsSync } from "fs";
import { join } from "path";

import Layout from "../../../layouts/Layout.astro";
import { useTranslations, type Locale } from "../../../i18n";
import { getAbsoluteLocaleUrl } from "astro:i18n";

// Source: https://docs.astro.build/en/guides/content-collections/#building-for-static-output-default
export async function getStaticPaths() {
  const posts = await getCollection("blog");

  const posts_ = posts.map((post) => {
    const [lang, ...slug] = post.id.split("/");

    return {
      params: {
        lang,
        slug: slug.join("/"),
      },
      props: {
        post,
      },
    };
  });

  return posts_;
}

const { post } = Astro.props;
const { Content } = await render(post);

const path = post.id.split("/").splice(1).join("/");

const postSlug = post.id.split("/").at(-1);
const ogImageFile = join(process.cwd(), "public", "og", `${postSlug}.png`);
const ogImage = existsSync(ogImageFile) ? `/og/${postSlug}.png` : undefined;

const locale = Astro.currentLocale as Locale;

const t = useTranslations(locale);
const a = 1;
---

<Layout
  openGraph={{
    title: post.data.title,
    url: getAbsoluteLocaleUrl(locale, `posts/${path}`),
    description: post.data.description,
    image: ogImage,
  }}
>
  <style is:global>
    h1 {
      font-size: 48px;
      font-weight: 800;
      line-height: 1.25;
    }
    h2 {
      font-size: 36px;
      font-weight: 800;
      line-height: 1.3;
    }
    h3 {
      font-size: 30px;
      font-weight: 700;
      line-height: 1.35;
    }
    h4 {
      font-size: 24px;
      font-weight: 700;
      line-height: 1.4;
    }
    h5 {
      font-size: 20px;
      font-weight: 700;
      line-height: 1.4;
    }
    h6 {
      font-weight: 700;
      line-height: 1.4;
    }
    h1,
    h2 {
      margin-block-start: 24px;
      margin-block-end: 12px;
    }
    h3,
    h4,
    h5,
    h6 {
      margin-block-start: 16px;
      margin-block-end: 12px;
    }
    /*
     * For example:
     * Alt-H1
     * ======
     * */
    [id^="alt"] {
      font-style: italic;
    }
    ol,
    ul,
    ol {
      margin-inline-start: 20px;
      margin-block-end: 20px;
    }
    li {
      list-style-type: decimal;
      margin-block-end: 8px;
    }
    li p {
      margin-block: 16px;
    }
    ul li {
      list-style-type: square;
      list-style-position: inside;
    }
    li input {
      margin-inline-end: 4px;
    }
    p,
    li {
      margin-block-end: 8px;
      font-size: 20px;
      line-height: 30px;
    }
    a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    img {
      border-radius: 4px;
      margin-block-start: 24px;
      margin-block-end: 20px;
    }
    pre {
      border-radius: 4px;
      padding-inline: 12px;
      padding-block: 12px;
      margin-block-end: 24px;
      margin-block-start: 24px;
    }
    /* Code should always be rendered ltr */
    pre {
      direction: ltr !important;
    }
    pre,
    pre *,
    code,
    code * {
      font-family:
        "Noto Sans Mono Variable", ui-monospace, SFMono-Regular, "SF Mono",
        Menlo, Consolas, "Liberation Mono", monospace;
    }
    /* Foldable code blocks */
    .code-fold-wrapper {
      direction: ltr;
      margin-block-start: 24px;
      margin-block-end: 24px;
    }
    .code-fold-wrapper pre {
      position: relative;
      margin-block: 0;
      /* Without this, re-collapsing after an expand can make the browser's
         scroll anchoring leave the preview scrolled partway down instead of
         showing the first line. */
      overflow-anchor: none;
    }
    /* Without this, overflow-x: auto (set inline by Shiki) makes browsers
       treat overflow-y as auto too, letting the preview scroll internally
       instead of being a fixed, clipped peek. */
    .code-fold-wrapper[data-collapsed="true"] pre {
      overflow-y: hidden;
    }
    .code-fold-fade {
      position: absolute;
      inset-inline: 0;
      bottom: 0;
      height: 64px;
      background: linear-gradient(to bottom, transparent, #24292e 80%);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.15s ease;
    }
    .code-fold-wrapper[data-collapsed="true"] .code-fold-fade {
      opacity: 1;
    }
    .code-fold-toggle {
      display: block;
      width: 100%;
      margin-block-start: 4px;
      padding-block: 8px;
      background-color: #2d333b;
      color: #e1e4e8;
      border: 1px solid #444c56;
      border-radius: 4px;
      font-size: 14px;
      font-family: "Open Sans Variable";
      cursor: pointer;
      text-align: center;
    }
    .code-fold-toggle:hover {
      background-color: #383f47;
    }
    /* Inline code */
    p code,
    li code {
      color: #4d4d4d;
      background-color: #ecebe4;
      border-radius: 4px;
      padding-inline: 4px;
      padding-block: 2px;
      margin-inline: 2px;
      overflow-wrap: anywhere;
    }
    table {
      margin-block: 40px;
      width: 100%;
      border-radius: 8px;
      border-collapse: separate;
      border-spacing: 0;
      width: 100%;
      background-color: #ecebe4ff;
    }
    tr:nth-child(even) > td {
      background-color: #e6e4dbff;
    }
    tr:last-child {
      td:first-child {
        border-end-start-radius: 8px;
      }

      td:last-child {
        border-end-end-radius: 8px;
      }
    }
    th:first-child {
      border-start-start-radius: 8px;
    }

    th:last-child {
      border-start-end-radius: 8px;
    }
    th,
    td {
      text-align: start;
    }
    th,
    td {
      padding-inline: 12px;
      padding-block: 12px;
    }
    blockquote {
      quotes: "\201C" "\201D" "\2018" "\2019";
      padding-block-start: 8px;
      margin-block: 32px;
    }
    blockquote::before {
      color: #878787;
      content: open-quote;
      font-size: 6em;
      line-height: 0.1em;
      margin-inline-end: 8px;
      vertical-align: -0.4em;
    }
    blockquote p {
      display: inline;
      font-size: 24px;
      font-weight: 600;
      font-style: italic;
    }
    hr {
      margin-block-start: 48px;
      margin-block-end: 32px;
      border-top: 1.5px solid #7d7d7d;
      border-style: dashed;
    }
  </style>
  <h1>
    {post.data.title}
  </h1>
  <Content />
</Layout>

<script>
  const LINE_LIMIT = 8;

  function setupCodeFolding() {
    document.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
      if (pre.dataset.foldInit) return;
      pre.dataset.foldInit = "true";

      const lines = pre.querySelectorAll(":scope > code > .line");
      if (lines.length <= LINE_LIMIT) return;

      const wrapper = document.createElement("div");
      wrapper.className = "code-fold-wrapper";
      wrapper.dataset.collapsed = "true";
      pre.replaceWith(wrapper);
      wrapper.appendChild(pre);

      const fade = document.createElement("div");
      fade.className = "code-fold-fade";
      pre.appendChild(fade);

      const lastVisibleLine = lines[LINE_LIMIT - 1];
      const collapsedHeight =
        lastVisibleLine.getBoundingClientRect().bottom -
        pre.getBoundingClientRect().top +
        12;
      pre.style.maxHeight = `${collapsedHeight}px`;

      const hiddenCount = lines.length - LINE_LIMIT;
      const collapsedLabel = `Show ${hiddenCount} more line${hiddenCount === 1 ? "" : "s"}`;
      const expandedLabel = "Show less";

      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.className = "code-fold-toggle";
      toggle.textContent = collapsedLabel;
      toggle.setAttribute("aria-expanded", "false");

      toggle.addEventListener("click", () => {
        const isCollapsed = wrapper.dataset.collapsed === "true";
        if (isCollapsed) {
          wrapper.dataset.collapsed = "false";
          pre.style.maxHeight = "";
          toggle.textContent = expandedLabel;
          toggle.setAttribute("aria-expanded", "true");
        } else {
          wrapper.dataset.collapsed = "true";
          pre.style.maxHeight = `${collapsedHeight}px`;
          pre.scrollTop = 0;
          toggle.textContent = collapsedLabel;
          toggle.setAttribute("aria-expanded", "false");
          wrapper.scrollIntoView({ block: "nearest" });
        }
      });

      wrapper.appendChild(toggle);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCodeFolding);
  } else {
    setupCodeFolding();
  }
</script>
